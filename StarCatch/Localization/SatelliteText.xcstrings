    "archive.editorial.qianfan.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An expanding low-orbit communications constellation. Each catalogue point is an individual orbital node in the same network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在扩展的低轨通信星座。目录中的每个点都是同一网络的一枚独立轨道节点。"
          }
        }
      }
    },
    "archive.editorial.qianfan.chapter-0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
