      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The international designator %1$@ links this object to its launch record. NORAD N%2$lld is the stable identity StarCatch uses for calculations and observation history."
