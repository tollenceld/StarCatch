    "archive.editorial.starlink.chapter-1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are observing one real satellite in this system. Different identifiers have their own orbital positions, but share the same program purpose and constellation archive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你此刻对准的是这个系统中的一枚真实卫星。不同编号拥有各自的轨道位置，但它们共享同一项目目的，因此都进入这份星座档案。"
          }
        }
      }
    },
