            "state" : "translated",
            "value" : "Publicly catalogued objects are calculated independently from the local snapshot"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已公开轨道对象由本地快照独立推算"
