        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国际编号 %1$@ 将当前目标关联到对应发射记录；NORAD N%2$lld 是 StarCatch 用于轨道计算与观测记录的稳定身份。"
          }
        }
      }
    },
