    },
    "archive.editorial.oneweb.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A low-orbit communications network. Satellites in near-polar orbits establish wide-area connections for fixed and mobile terminals."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低轨通信网络。卫星沿近极轨道分布，为地面与移动终端建立广域连接。"
          }
        }
      }
    },
    "archive.editorial.oneweb.chapter-0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A network reaching high latitudes"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "越过高纬度的轨道网"
          }
        }
      }
    },
    "archive.editorial.oneweb.chapter-0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OneWeb nodes repeatedly cover Earth from high-inclination orbits. They jointly connect ground stations, businesses and mobile users rather than serving as independent missions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OneWeb 的节点沿高倾角轨道反复覆盖地球。它们不是彼此独立的任务，而是共同承担连接地面站、企业与移动用户的网络角色。"
          }
        }
      }
    },
    "archive.editorial.oneweb.chapter-1.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading this node"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何阅读这枚节点"
          }
        }
      }
    },
    "archive.editorial.oneweb.chapter-1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every OneWeb point corresponds to an individual orbital object. The archive describes their common system, keeping shared background distinct from each node’s identity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天空中的每个 OneWeb 点位都对应一个独立轨道对象；深入档案则聚焦它们共同构成的系统，避免用相同文字伪装成不同故事。"
          }
        }
      }
    },
    "archive.editorial.oneweb.milestone-0.event" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satellites were launched in batches into high-inclination low orbits"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卫星被分批送入高倾角近地轨道"
          }
        }
      }
    },
    "archive.editorial.oneweb.milestone-1.event" : {
      "extractionState" : "manual",
