    "archive.curated.object" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "VERIFIED OBJECT" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单星资料" } } } },
    "archive.curated.family" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "VERIFIED SERIES" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系列资料" } } } },
    "archive.generated.organization" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OBJECT ARCHIVE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标档案" } } } },
    "archive.generated.review" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SOURCE-BOUNDED" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "来源限定" } } } },
    "archive.generated.lead" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ is cataloged as %2$@ / N%3$lld. Its %4$@ orbit is calculated on device from the bundled GP/OMM snapshot; no unverified mission purpose or operating state is inferred." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ 以 %2$@ / N%3$lld 收录于公开目录。其 %4$@ 轨道由设备使用随包 GP/OMM 快照推算；资料不足时不推测任务用途或运行状态。" } } } },
    "archive.generated.identity.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Identity and launch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "身份与发射" } } } },
    "archive.generated.identity.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The international designator %1$@ links this object to its launch record. NORAD N%2$lld is the stable identity StarCatch uses for calculations and observation history." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "国际编号 %1$@ 将当前目标关联到对应发射记录；NORAD N%2$lld 是 StarCatch 用于轨道计算与观测记录的稳定身份。" } } } },
    "archive.generated.orbit.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Orbital character" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道特征" } } } },
    "archive.generated.orbit.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The bundled elements describe a %1$.1f-minute orbit inclined %2$.2f degrees, with estimated perigee and apogee of %3$.0f and %4$.0f KM. These are propagated catalog elements, not live operator telemetry." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "随包轨道根数描述了一条周期约 %1$.1f 分钟、倾角 %2$.2f° 的轨道，估算近地点与远地点分别为 %3$.0f 和 %4$.0f KM。这是目录根数推算值，不是运营方实时遥测。" } } } },
    "archive.generated.fact.type" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "类型" } } } },
