    "archive.editorial.starlink.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A low-Earth-orbit broadband network. Many nodes occupy multiple orbital shells, handing coverage between satellites as they move past ground terminals."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低轨宽带网络。大量节点分布在多个轨道壳层，以连续接力覆盖地面终端。"
          }
        }
      }
    },
    "archive.editorial.starlink.chapter-0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A network constantly in motion"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一张持续移动的网络"
          }
        }
      }
    },
    "archive.editorial.starlink.chapter-0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starlink is a communications system made of many low-Earth-orbit nodes, not a mission carried by one satellite. Each node crosses the horizon while other nodes continue coverage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starlink 不是一颗卫星的任务，而是由许多近地轨道节点共同组成的通信系统。单个节点不断越过地平线，网络通过其他节点接续覆盖。"
          }
        }
      }
    },
