          }
        }
      }
    },
    "archive.editorial.qianfan.chapter-0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qianfan uses many low-Earth-orbit satellites to form a communications network. Bands of points in the sky arise from neighbouring orbital planes, not from repeated drawings of one satellite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "千帆以大量近地轨道卫星构成通信网络。观测时看到的长带状点位来自相邻轨道面，而不是同一颗卫星的重复绘制。"
          }
        }
      }
    },
