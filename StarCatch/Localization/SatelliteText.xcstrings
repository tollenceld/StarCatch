        }
      }
    },
    "archive.editorial.orbcomm.lead" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A low-orbit network for the Internet of Things and asset communications, connecting remote terminals through narrowband data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面向物联网与资产通信的低轨网络，以窄带数据连接偏远区域的终端。"
          }
        }
      }
    },
    "archive.editorial.orbcomm.chapter-0.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short messages for machines"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为机器传递短消息"
          }
        }
      }
    },
    "archive.editorial.orbcomm.chapter-0.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbcomm nodes mainly support asset tracking, sensors and machine communications. The aim is not high-bandwidth imagery, but keeping equipment connected beyond conventional networks."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbcomm 的轨道节点主要服务资产跟踪、传感器与机器数据通信。它关注的不是大带宽画面，而是让远离常规网络的设备保持联系。"
          }
        }
      }
    },
