    "archive.editorial.qianfan.chapter-1.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each identifier retains its own orbital identity and current position. Program background, shared purpose and system architecture are collected in the common archive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个编号仍保留自己的轨道身份和实时位置；项目背景、共同任务与系统形态集中在这份共享档案中。"
          }
        }
      }
    },
    "archive.editorial.qianfan.milestone-0.event" : {
      "extractionState" : "manual",
      "localizations" : {
