    "observations.clear" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear History" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除记录" } } } },
    "observations.clear.confirmation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear all observation history?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除全部观测记录？" } } } },
    "observations.clear.note" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Display preferences and manual progress will be preserved." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示偏好与手册状态不会被清除。" } } } },
    "observations.clear_all" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear All" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清除全部" } } } },
    "observations.detail.hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "View observation details for this object" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看该天体的观测详情" } } } },
    "observations.empty.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Aim at an artificial object to read its archive. With Capture Confirmation enabled, confirmed observations are stored on this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将准星对准人造天体可即时阅读档案；开启“确认捕获”并确认目标后，观测会保存在这台设备上。" } } } },
    "observations.empty.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No observations yet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚无观测记录" } } } },
    "observations.field.altitude" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Altitude" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高度" } } } },
    "observations.field.azimuth" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Azimuth" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "方位" } } } },
    "observations.field.category" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Category" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "类别" } } } },
    "observations.field.elevation" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Elevation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仰角" } } } },
    "observations.field.first_lock" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "First lock" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "首次锁定" } } } },
    "observations.field.latest_lock" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Latest lock" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最近锁定" } } } },
    "observations.field.launch" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Launch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "发射" } } } },
    "observations.field.orbit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Orbit" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道" } } } },
    "observations.field.range" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Range" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "距离" } } } },
    "observations.field.speed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "速度" } } } },
    "observations.field.status" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Status" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "状态" } } } },
    "observations.field.time" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Observed at" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测时刻" } } } },
    "observations.field.total" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Total locks" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "累计次数" } } } },
    "observations.latest" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Latest: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最近：%@" } } } },
    "observations.metric.identified" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Identified" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已识别" } } } },
    "observations.metric.locks" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Locks" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "锁定次数" } } } },
    "observations.more.accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "More observation actions" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更多观测记录操作" } } } },
    "observations.none_short" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "None" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚无记录" } } } },
    "observations.object.fallback" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cataloged object %@ in a %@ orbit. Its position is calculated from the bundled orbital snapshot." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目录目标 %@ 位于 %@ 轨道；当前位置由随包轨道快照在设备上推算。" } } } },
    "observations.open.hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open complete observation history" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开完整观测记录" } } } },
    "observations.row.accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, last observed %2$@, %3$d times" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@，最近观测 %2$@，共 %3$d 次" } } } },
    "observations.section.mission" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mission" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "任务" } } } },
    "observations.section.orbit_snapshot" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Orbital reading at observation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当时的轨道读数" } } } },
    "observations.summary" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d identified · %d locks" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已识别 %d 个 · 共锁定 %d 次" } } } },
    "observations.summary.accessibility" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d objects identified. Latest observation: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已识别 %d 个天体，最近观测 %@" } } } },
    "manual.1.paragraph.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At this moment, stations, telescopes, navigation constellations, and old rocket bodies are passing overhead." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此刻，空间站、望远镜、导航星座与旧火箭正在越过你头顶。" } } } },
    "manual.1.paragraph.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Most do not shine and cannot be seen with the naked eye. This instrument returns them to your field of awareness." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "它们不发光，肉眼不可见。这台仪器把它们放回你的感知范围。" } } } },
    "manual.1.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "THE INSTRUMENT" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台仪器" } } } },
    "manual.2.paragraph.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Raise the device. The screen becomes your field of view, and the center reticle becomes your direction." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "举起设备，屏幕即视野，中心十字丝即指向。" } } } },
    "manual.2.paragraph.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move slowly. Points in the field are cataloged orbital objects; edge beacons indicate tracked objects outside the current view." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "缓慢移动。视野中的光点是真实在轨物；空域之外的目标会由屏幕边缘提示方向。" } } } },
    "manual.2.paragraph.3" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bring the reticle near an object to reveal its archive. The panel remains briefly after you move away; pin it to keep it visible. If Capture Confirmation is enabled in Settings, confirmation and switching controls appear in the main view." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "让十字丝靠近它，档案会随视线浮现。移开后仍保留短暂阅读时间；触碰面板可将它固定。若在设置中开启“确认捕获”，主视野才会出现确认、切换与取消捕获按钮。" } } } },
    "manual.2.paragraph.4" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Archive reveals the full record. Individual spacecraft use their own source record; large constellations share verified program context while preserving each node's identity and orbit." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完整信息出现后，画面下方会浮现“深入档案”。单体卫星读取自己的资料；大型星座的任意节点进入同一份项目档案，避免用重复文字伪装成不同故事。" } } } },
    "manual.2.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HOW TO OBSERVE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如何观察" } } } },
    "manual.3.paragraph.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the global orbit view from the upper-left control. Its lower edge contains the observation clock; move the scale to inspect the past or future." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点按左上角进入全局星图，屏幕下缘才会出现观测时钟。左右拨动刻度，即可抵达过去或未来。" } } } },
    "manual.3.paragraph.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose Return to Now to restore LIVE time. Leaving the global view also returns the observation clock to the present." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点按“返回此刻”即可回到 LIVE；退出全局星图时，时间也会先归还到此刻。" } } } },
    "manual.3.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TIME COORDINATE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "时间坐标" } } } },
    "manual.4.paragraph.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Orbits come from NORAD GP elements and are propagated on device with SGP4. The age of the data is reported honestly." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道来自 NORAD 两行根数，并由 SGP4 在设备上推算；数据龄期会被如实标注。" } } } },
    "manual.4.paragraph.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location and motion are used only to establish observer coordinates and device pointing. If location is denied, the instrument clearly uses an assumed coordinate." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "位置与姿态只用于建立观察者坐标和设备指向，不离开设备。拒绝定位后，仪器会明确使用假定坐标。" } } } },
    "manual.4.paragraph.3" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These results are for education and observation, not navigation, collision avoidance, or any safety decision." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些结果用于教育与观测，不用于导航、碰撞规避或任何安全决策。" } } } },
    "manual.4.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DATA AND FRAME" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "数据与坐标" } } } },
    "manual.5.paragraph.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Use the Settings control in the upper-right corner to reopen this manual, adjust the display, or read the privacy statement." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "右上角的设置入口可以重新打开手册、显示控制与隐私说明。" } } } },
    "manual.5.paragraph.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The sky is always there. StarCatch helps you see its orbital layer when you look up." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "天空一直在那里。它只负责在你抬头的时候，替你看见。" } } } },
    "manual.5.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "READY FOR OBSERVATION" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测就绪" } } } },
    "manual.begin" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Begin Observation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始观测" } } } },
    "manual.catalog_count" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%d OBJECTS" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%d 个目标" } } } },
    "manual.chapter.1" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CHAPTER 01" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第一章" } } } },
    "manual.chapter.2" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CHAPTER 02" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第二章" } } } },
    "manual.chapter.3" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CHAPTER 03" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第三章" } } } },
    "manual.chapter.4" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CHAPTER 04" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第四章" } } } },
    "manual.chapter.final" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "FINAL" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "终章" } } } },
    "manual.continue" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续" } } } },
    "manual.continue.hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue to the next page" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续到下一页" } } } },
    "manual.epoch_age" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%dD" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%d 天" } } } },
    "manual.field.epoch_age" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "EPOCH AGE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历元年龄" } } } },
    "manual.field.model" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "MODEL" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型" } } } },
    "manual.field.source" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SOURCE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "来源" } } } },
    "manual.finish_reading" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish Reading" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成阅读" } } } },
    "manual.page" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Page %d" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %d 页" } } } },
    "manual.skip" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过" } } } },
    "navigation.manual" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Observation Manual" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测手册" } } } },
    "accessibility.open_browser" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in browser" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在浏览器中打开" } } } },
    "navigation.privacy" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私" } } } },
    "navigation.settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设置" } } } },
    "privacy.choice.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You can revoke location access in Settings, or delete the app at any time to remove all locally stored data." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你可以在系统设置中撤销定位权限，也可以随时删除应用以移除全部本地数据。" } } } },
    "privacy.choice.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your choices" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "你的选择" } } } },
    "privacy.location.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "StarCatch requests precise location to calculate the observer's coordinates and true-north reference on device; approximate location can introduce visible parallax for low-orbit objects. Motion sensors determine device pointing. Location and attitude are neither uploaded nor persisted. You may still choose approximate location; the app clearly reports reduced accuracy. If access is denied, Beijing is used as an explicitly labeled assumed location." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "定位默认请求完整精度，只用于在设备上计算观察者坐标与真北方向；低轨目标会因近似位置产生明显视差。陀螺仪只用于确定设备指向，位置和姿态不会上传或持久化。你仍可在系统中选择近似位置；精度不足时应用会明确提示。拒绝定位后，应用使用北京作为明确标注的假定坐标。" } } } },
    "privacy.location.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location and attitude" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "位置与姿态" } } } },
    "privacy.network.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This version creates no account, contains no advertising, analytics, or tracking code, and sends no personal data to the developer or third parties. SatelliteKit performs orbital calculations entirely on device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前版本不创建账户，不包含广告、分析或跟踪代码，也不会向开发者或第三方传输个人数据。SatelliteKit 仅在本机执行轨道计算。" } } } },
    "privacy.network.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Network and third parties" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网络与第三方" } } } },
    "privacy.public.label" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "PUBLIC POLICY" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公开政策" } } } },
    "privacy.public.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "View public privacy policy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看公开隐私政策" } } } },
    "privacy.records.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Observation history, manual progress, and display preferences are stored only on this device to restore your instrument state. Observation history can be cleared in Settings." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测记录、手册阅读状态和显示偏好仅保存在本机，用于恢复你的仪器状态。你可以在设置中清除观测记录。" } } } },
    "privacy.records.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local records" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地记录" } } } },
    "privacy.summary.no_account" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No account" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不创建账户" } } } },
    "privacy.summary.no_location_upload" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location is never uploaded" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不上传位置" } } } },
    "privacy.summary.no_tracking" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No tracking" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不进行追踪" } } } },
    "privacy.summary.on_device" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All calculations stay on device" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有计算均在设备上完成" } } } },
    "privacy.support.label" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SUPPORT" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "支持" } } } },
    "privacy.support.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy or support feedback" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "反馈隐私或支持问题" } } } },
    "%@  ·  N%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@  ·  N%2$@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@  ·  N%2$@" } } } },
    "%@ 可见" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ visible" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 可见" } } } },
    "+24 H" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "+24 H" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "+24 小时" } } } },
    "CATALOG OFFLINE" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CATALOG OFFLINE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目录离线" } } } },
    "DISPLAY  %@  /  CATALOG  %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DISPLAY  %1$@  /  CATALOG  %2$@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示  %1$@  /  目录  %2$@" } } } },
    "DRAG  ↕↔  ·  PINCH / ROTATE  ·  DOUBLE TAP  RESET" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "DRAG  ↕↔  ·  PINCH / ROTATE  ·  DOUBLE TAP  RESET" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖动  ↕↔  ·  双指缩放 / 旋转  ·  双击复位" } } } },
    "OBSERVATION SYSTEM ·" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OBSERVATION SYSTEM ·" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测系统 ·" } } } },
    "ORBITAL FIELD INSTRUMENT" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ORBITAL FIELD INSTRUMENT" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道观测仪" } } } },
    "PRIVACY · ON DEVICE · 2026-08-01" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "PRIVACY · ON DEVICE · 2026-08-01" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私 · 仅限本机 · 2026-08-01" } } } },
    "SET" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SET" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "落下" } } } },
    "SOURCES · OFFLINE EDITION" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "SOURCES · OFFLINE EDITION" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "资料来源 · 离线版本" } } } },
    "STARCATCH" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "STARCATCH" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "STARCATCH" } } } },
    "STARCATCH · %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "STARCATCH · %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "STARCATCH · %@" } } } },
    "StarCatch 与 SatelliteKit 依据 MIT License 发布。轨道目录归属 CelesTrak；完整声明随项目公开发布。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "StarCatch and SatelliteKit are released under the MIT License. The orbital catalog is provided by CelesTrak; full notices ship with the project." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "StarCatch 与 SatelliteKit 依据 MIT License 发布。轨道目录归属 CelesTrak；完整声明随项目公开发布。" } } } },
    "±24H" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "±24H" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "±24 小时" } } } },
    "×%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "×%@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "×%@" } } } },
    "−24 H" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "−24 H" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "−24 小时" } } } },
    "一台面向真实天空的轨道观测仪。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "An orbital instrument for the real sky." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一台面向真实天空的轨道观测仪。" } } } },
    "举起手机，辨认此刻经过你上空的人造天体，沿时间查看它们的轨迹。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Raise your phone to identify artificial objects passing overhead and follow their paths through time." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "举起手机，辨认此刻经过你上空的人造天体，沿时间查看它们的轨迹。" } } } },
    "仅供教育与观测，不用于导航、碰撞规避或安全决策。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For education and observation only. Not for navigation, collision avoidance, or safety decisions." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅供教育与观测，不用于导航、碰撞规避或安全决策。" } } } },
    "任务、轨道与来源" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mission, orbit, and sources" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "任务、轨道与来源" } } } },
    "删除" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "历史叙述随版本校订；位置与速度由 App 内置 CelesTrak GP/OMM 元素在设备上推算。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Historical notes are reviewed with each release. Position and velocity are calculated on device from the bundled CelesTrak GP/OMM elements." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历史叙述随版本校订；位置与速度由 App 内置 CelesTrak GP/OMM 元素在设备上推算。" } } } },
    "复位视场" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset View" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复位视场" } } } },
    "官方任务页面" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Official Mission Page" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "官方任务页面" } } } },
    "对准另一目标切换，或取消当前捕获。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Aim at another object to switch, or cancel the current capture." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对准另一目标切换，或取消当前捕获。" } } } },
    "将准星对准人造天体可即时阅读档案；开启“确认捕获”并确认目标后，观测会保存在这台设备上。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Aim the reticle at an artificial object to read its archive. When Capture Confirmation is enabled, confirmed observations are saved on this device." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将准星对准人造天体可即时阅读档案；开启“确认捕获”并确认目标后，观测会保存在这台设备上。" } } } },
    "尚无观测记录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No observations yet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "尚无观测记录" } } } },
    "已识别 %@ 个 · 共锁定 %@ 次" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ identified · %2$@ locks" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已识别 %1$@ 个 · 共锁定 %2$@ 次" } } } },
    "当前位置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Location" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前位置" } } } },
    "收起" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Collapse" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "收起" } } } },
    "显示偏好与手册状态不会被清除。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Display preferences and manual progress will be preserved." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示偏好与手册状态不会被清除。" } } } },
    "最近：%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Latest: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最近：%@" } } } },
    "查看档案" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "View Archive" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "查看档案" } } } },
    "深入档案" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Archive" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "深入档案" } } } },
    "目录来自 CelesTrak GP/OMM 快照；SatelliteKit 在设备上执行 SGP4 传播。轨道数据不会在运行时联网刷新。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The catalog comes from a bundled CelesTrak GP/OMM snapshot. SatelliteKit performs SGP4 propagation on device; orbital data is not refreshed at runtime." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目录来自 CelesTrak GP/OMM 快照；SatelliteKit 在设备上执行 SGP4 传播。轨道数据不会在运行时联网刷新。" } } } },
    "目标筛选" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Object Filters" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目标筛选" } } } },
    "继续缩小 · 查看完整轨道" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep pinching · View all orbits" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续缩小 · 查看完整轨道" } } } },
    "观测记录" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Observations" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测记录" } } } },
    "轨道目录未能载入。请重新安装应用；若问题持续，请联系支持。" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The orbital catalog could not be loaded. Reinstall the app; if the problem persists, contact support." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道目录未能载入。请重新安装应用；若问题持续，请联系支持。" } } } },
    "进入观测" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Begin Observation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "进入观测" } } } },
    "选择会实时作用于当前天空" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Selections update the current sky immediately" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择会实时作用于当前天空" } } } },
    "重置" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重置" } } } },
    "默认视域" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default Field of View" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认视域" } } } },
    "boot.intro.body" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Raise your iPhone to identify human-made objects crossing the sky, then move through time to inspect their paths." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "举起手机，辨认此刻经过上空的人造天体，并沿时间查看它们的轨迹。" } } } },
    "boot.intro.eyebrow" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ORBITAL FIELD INSTRUMENT" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道观测仪" } } } },
    "boot.intro.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A precise instrument for the real sky." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一台面向真实天空的精密观测仪。" } } } },
    "boot.module.attitude" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ATTITUDE" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "姿态" } } } },
    "boot.module.catalog" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CATALOG" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "目录" } } } },
    "boot.module.observation_model" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OBSERVATION MODEL" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测模型" } } } },
    "boot.module.orbit" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ORBIT" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道" } } } },
    "boot.module.orbit_solver" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ORBIT SOLVER" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道解算" } } } },
    "boot.module.verified" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "VERIFIED" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已验证" } } } },
