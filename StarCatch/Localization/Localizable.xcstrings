    },
    "将准星对准人造天体可即时阅读档案；开启“确认捕获”并确认目标后，观测会保存在这台设备上。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aim the reticle at an artificial object to read its archive. When Capture Confirmation is enabled, confirmed observations are saved on this device."
          }
        },
        "zh-Hans" : {
