    "guide.capture.confirm" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Center an object, then confirm continuous capture."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准目标，再确认持续捕获。"
          }
        }
      }
    },
    "guide.capture.direct" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the reticle onto an object to reveal its archive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将准星移向目标，档案会随视线出现。"
          }
        }
      }
    },
    "guide.capture.switch" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aim at another object to switch, or cancel the current capture."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准另一目标切换，或取消当前捕获。"
          }
        }
      }
    },
    "manual.1.paragraph.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At this moment, stations, telescopes, navigation constellations, and old rocket bodies are passing overhead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此刻，空间站、望远镜、导航星座与旧火箭正在越过你头顶。"
          }
        }
      }
    },
    "manual.1.paragraph.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most do not shine and cannot be seen with the naked eye. This instrument returns them to your field of awareness."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们不发光，肉眼不可见。这台仪器把它们放回你的感知范围。"
          }
        }
      }
    },
    "manual.1.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "THE INSTRUMENT"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台仪器"
          }
        }
      }
    },
    "manual.2.paragraph.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise the device. The screen becomes your field of view, and the center reticle becomes your direction."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举起设备，屏幕即视野，中心十字丝即指向。"
          }
        }
      }
    },
    "manual.2.paragraph.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move slowly. Points in the field are cataloged orbital objects; edge beacons indicate tracked objects outside the current view."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓慢移动。视野中的光点是真实在轨物；空域之外的目标会由屏幕边缘提示方向。"
          }
        }
      }
    },
    "manual.2.paragraph.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring the reticle near an object to reveal its archive. The panel remains briefly after you move away; pin it to keep it visible. If Capture Confirmation is enabled in Settings, confirmation and switching controls appear in the main view."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让十字丝靠近它，档案会随视线浮现。移开后仍保留短暂阅读时间；触碰面板可将它固定。若在设置中开启“确认捕获”，主视野才会出现确认、切换与取消捕获按钮。"
          }
        }
      }
    },
    "manual.2.paragraph.4" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Archive reveals the full record. Individual spacecraft use their own source record; large constellations share verified program context while preserving each node's identity and orbit."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完整信息出现后，画面下方会浮现“深入档案”。单体卫星读取自己的资料；大型星座的任意节点进入同一份项目档案，避免用重复文字伪装成不同故事。"
          }
        }
      }
    },
    "manual.2.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HOW TO OBSERVE"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如何观察"
          }
        }
      }
    },
    "manual.3.paragraph.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the global orbit view from the upper-left control. Its lower edge contains the observation clock; move the scale to inspect the past or future."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按左上角进入全局星图，屏幕下缘才会出现观测时钟。左右拨动刻度，即可抵达过去或未来。"
          }
        }
      }
    },
    "manual.3.paragraph.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Return to Now to restore LIVE time. Leaving the global view also returns the observation clock to the present."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“返回此刻”即可回到 LIVE；退出全局星图时，时间也会先归还到此刻。"
          }
        }
      }
    },
    "manual.3.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIME COORDINATE"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间坐标"
          }
        }
      }
    },
    "manual.4.paragraph.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orbits come from NORAD GP elements and are propagated on device with SGP4. The age of the data is reported honestly."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轨道来自 NORAD 两行根数，并由 SGP4 在设备上推算；数据龄期会被如实标注。"
          }
        }
      }
    },
    "manual.4.paragraph.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location and motion are used only to establish observer coordinates and device pointing. If location is denied, the instrument clearly uses an assumed coordinate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置与姿态只用于建立观察者坐标和设备指向，不离开设备。拒绝定位后，仪器会明确使用假定坐标。"
          }
        }
      }
    },
    "manual.4.paragraph.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These results are for education and observation, not navigation, collision avoidance, or any safety decision."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些结果用于教育与观测，不用于导航、碰撞规避或任何安全决策。"
          }
        }
      }
    },
    "manual.4.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DATA AND FRAME"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据与坐标"
          }
        }
      }
    },
    "manual.5.paragraph.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Settings control in the upper-right corner to reopen this manual, adjust the display, or read the privacy statement."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上角的设置入口可以重新打开手册、显示控制与隐私说明。"
          }
        }
      }
    },
    "manual.5.paragraph.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sky is always there. StarCatch helps you see its orbital layer when you look up."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天空一直在那里。它只负责在你抬头的时候，替你看见。"
          }
        }
      }
    },
    "manual.5.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
