            "state" : "translated",
            "value" : "隐私 · 仅限本机 · 2026-08-01"
          }
        }
      }
    },
    "privacy.choice.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can revoke location access in Settings, or delete the app at any time to remove all locally stored data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以在系统设置中撤销定位权限，也可以随时删除应用以移除全部本地数据。"
          }
        }
      }
    },
    "privacy.choice.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choices"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择"
          }
        }
      }
    },
    "privacy.location.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "StarCatch requests precise location to calculate the observer's coordinates and true-north reference on device; approximate location can introduce visible parallax for low-orbit objects. Motion sensors determine device pointing. Location and attitude are neither uploaded nor persisted. You may still choose approximate location; the app clearly reports reduced accuracy. If access is denied, Beijing is used as an explicitly labeled assumed location."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定位默认请求完整精度，只用于在设备上计算观察者坐标与真北方向；低轨目标会因近似位置产生明显视差。陀螺仪只用于确定设备指向，位置和姿态不会上传或持久化。你仍可在系统中选择近似位置；精度不足时应用会明确提示。拒绝定位后，应用使用北京作为明确标注的假定坐标。"
          }
        }
      }
    },
    "privacy.location.title" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location and attitude"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置与姿态"
          }
        }
      }
    },
    "privacy.network.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This version creates no account, contains no advertising, analytics, or tracking code, and sends no personal data to the developer or third parties. SatelliteKit performs orbital calculations entirely on device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前版本不创建账户，不包含广告、分析或跟踪代码，也不会向开发者或第三方传输个人数据。SatelliteKit 仅在本机执行轨道计算。"
          }
        }
      }
    },
