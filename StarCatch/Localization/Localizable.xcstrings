    "accessibility.toggle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Double-tap to toggle" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻触切换" } } } },
    "action.cancel" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
