    "一台面向真实天空的轨道观测仪。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An orbital instrument for the real sky."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一台面向真实天空的轨道观测仪。"
          }
        }
      }
    },
    "举起手机，辨认此刻经过你上空的人造天体，沿时间查看它们的轨迹。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raise your phone to identify artificial objects passing overhead and follow their paths through time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "举起手机，辨认此刻经过你上空的人造天体，沿时间查看它们的轨迹。"
          }
        }
      }
    },
    "仅供教育与观测，不用于导航、碰撞规避或安全决策。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For education and observation only. Not for navigation, collision avoidance, or safety decisions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供教育与观测，不用于导航、碰撞规避或安全决策。"
          }
        }
      }
    },
