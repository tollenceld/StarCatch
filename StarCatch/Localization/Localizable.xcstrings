    "date.today" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Today" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天" } } } },
    "date.yesterday" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Yesterday" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "昨天" } } } },
    "navigation.back" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Back to %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "返回%@" } } } },
    "navigation.instrument_status" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Instrument Status" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仪器状态" } } } },
    "navigation.observation_detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Observation Detail" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录详情" } } } },
    "navigation.observations" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Observations" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "观测记录" } } } },
    "navigation.sky" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sky" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "天空" } } } },
    "object.status.cataloged" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "CATALOGED" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轨道在列" } } } },
